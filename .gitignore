# Dependencies
node_modules/

# Build outputs & caches
.vercel/
.tanstack/
dist/

# Sandbox / platform internals (regenerated by the App Builder workspace).
# app-env.json is the exception: it is the template's shipped build-flag
# default (auth off), read by scripts/with-app-env.mjs and its tests.
.grok/*
!.grok/app-env.json
artifacts/

# QA evidence (local only; docs/screenshot.png is the committed one)
screenshots/
audio-tests/
*.log

# Audio corpus working data (regenerable scratch — see scripts/corpus/)
# Default location is $CORPUS_DIR (/tmp/corpus); a checked-in copy would be
# ~100 MB of derived audio, so only the manifest snapshot is versioned.

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
